{
  "schemaVersion": 1,
  "id": "smoothgl_pulse_vulkan_bridge",
  "version": "${version}",
  "name": "SmoothGL Pulse Vulkan Full",
  "description": "Pulse Visuals compatibility layer with the complete VulkanMod 0.5.4 runtime bundled inside one Minecraft 1.21.4 Fabric JAR.",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["dev.smoothgl.pulsevulkan.LwjglStackBootstrap"],
    "client": ["dev.smoothgl.pulsevulkan.PulseVulkanBridge"]
  },
  "mixins": ["pulse-vulkan-bridge.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "1.21.4",
    "java": ">=21",
    "vulkanmod": ">=0.5.4"
  }
}
